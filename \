---
import ProjectItem from "./ProjectItem.astro"
---

<div class="container">
    <div class="filler"></div>
    <div class="first"></div>
    <div class="main-container">
        <div class="col">
            <div class="skewed">
                <ProjectItem />
                <ProjectItem />
                <ProjectItem />
            </div>
        </div>
    </div>
    <div class="last"></div>
    <div class="filler"></div>
</div>

<style>
    .container {
        margin-top:50px;
        height: 550px;
        display: flex;
        flex-direction: row;
    }
    .first {
        flex: 0 0 170px;
        background-color: #ff2e97;
        clip-path: polygon(0 0,0 0, 100% 100%, 0 100%);
        margin: 40px 0;
    }
    .last {
        flex: 0 0 170px;
        background-color: #ff2e97;
        margin: 40px 0;
        clip-path: polygon(0 0,100% 0, 100% 100%, 100% 100%);
    }
    .filler {
        margin: 40px 0;
        background-color: #ff2e97;
        flex: 1 0 0;
        box-sizing: border-box;
    }
    .main-container {
        flex: 0 1 1000px;
        display: flex;
        max-width: 1000px;
        flex-direction: row;
        margin-inline: -20px;
        align-items: center;
        gap: 10px;
    }
    .col {
        width: 100%;
        height: 100%;
    }
    .skewed {
        width: 100%;
        height: 100%;
        padding: 20px;
        background-color: aqua;
        overflow-y: scroll;
        overflow-x: hidden;
        transform: skewX(20deg);
    }
</style>
