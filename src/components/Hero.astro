---
import ballon from "../assets/ballon.svg"
---

<div class="hero">
    <h1>LYNCON BAEZ</h1>
    <div class="subtitle">
        <img src={ballon.src}/>
        <span>Full-stack developer</span>
    </div>
</div>

<style>
    .hero {
        flex: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
    }
    h1 {
        text-align: center;
        margin: 0 auto;
        line-height: 0.9;
        max-width: 500px;
        font-size: 10rem;
        font-weight: lighter;
        color: white;
        font-family: var(--font-anton), sans-serif;
    }
    .subtitle {
        position: relative;
        margin-top: -2.5rem;
        margin-right: -5rem;
        top: 0;
        width: 400px;
    }
    .subtitle img {
        width: 100%;
    }
    .subtitle span {
        font-family: var(--font-oxanium);
        font-weight: bold;
        position: absolute;
        font-size: 2rem;
        left: 35px;
        bottom: 35px;
        transform: rotateZ(-8deg);
    }
    @media (max-width: 570px) {
        h1 {
            font-size: 5rem;
            margin: 0 10px;
        }
        .subtitle {
            margin-top: -1.5rem;
            margin-right: -1rem;
            top: 0;
            width: 300px;
        }
        .subtitle span {
            font-size: 1.4rem;
            bottom: 30px;
        }
    }
</style>
