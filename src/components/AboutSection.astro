---
import Checker from "./Checker.astro";
import star from "../assets/star.svg";
import Halftone from "./Halftone.astro";
---

<script>
    const drawDivider = (ctx: CanvasRenderingContext2D, pointsUp = false) => {
        ctx.canvas.width = ctx.canvas.clientWidth;
        ctx.canvas.height = ctx.canvas.clientHeight;

        const tiltHeight = 30;
        const solidBandHeight = 20;
        const getTilt = (x: number) => (x / ctx.canvas.width) * tiltHeight;
        const getBaseline = (x: number) => pointsUp
            ? ctx.canvas.height - solidBandHeight - tiltHeight + getTilt(x)
            : solidBandHeight + getTilt(x);
        const toothDirection = pointsUp ? -1 : 1;

        ctx.shadowColor = "rgba(0, 0, 0, 0.2)";
        ctx.shadowBlur = 6;
        ctx.shadowOffsetX = 0;
        ctx.shadowOffsetY = pointsUp ? -6 : 6;
        ctx.fillStyle = "#0A193B";
        ctx.beginPath();
        ctx.moveTo(0, getBaseline(0))
        let x = 0;
        while (x < ctx.canvas.width) {
            x += 25;
            ctx.lineTo(x, getBaseline(x) + 20 * toothDirection);
            x += 25;
            ctx.lineTo(x, getBaseline(x));
        }
        if (pointsUp) {
            ctx.lineTo(ctx.canvas.width, ctx.canvas.height);
            ctx.lineTo(0, ctx.canvas.height);
        } else {
            ctx.lineTo(ctx.canvas.width, 0);
            ctx.lineTo(0, 0);
        }
        ctx.closePath();
        ctx.fill();
    }

    const init = () => {
        const canvases = Array.from(
            document.querySelectorAll<HTMLCanvasElement>(".custom-divider"),
        );
        canvases.forEach((canvas, index) => {
            if (!canvas)
                return;
            const ctx = canvas.getContext("2d");
            if (!ctx)
                return;

            const resizeObserver = new ResizeObserver(() => {
                drawDivider(ctx, index === 1);
            })
            resizeObserver.observe(canvas);
            drawDivider(ctx, index === 1);
        });
    }

    init();
</script>

<section>
    <canvas class="custom-divider"></canvas>
    <div class="container">
        <div class="col">
            <div class="heading">
                <h1>About me</h1>
                <Checker squareSize={5} height="10px"/>
            </div>
            <p>Lorem ipsum dolor sit amet, consectetur adipiscing elit. Mauris nec  condimentum erat. Vivamus interdum lobortis malesuada. Morbi lacinia  arcu ac lectus commodo, at viverra dui pretium. Cras iaculis lorem  aliquam auctor molestie. Vestibulum accumsan dignissim imperdiet.</p>
        </div>
        <div class="col detail">
            <Halftone class="my-halftone"/>
        </div>
    </div>
    <canvas class="custom-divider"></canvas>

</section>

<style>
    :global(.my-halftone) {
        position: absolute;
        width: 100px;
        mask-image: url("../assets/star.svg");
        mask-size: contain;
        mask-position: center;
        mask-repeat: no-repeat
    }
    section {
        background-color: #B5FD14;
    }
    .container {
        width: min(100%, 800px);
        display: flex;
        padding: 2rem;
        margin-inline: auto;
        box-sizing: border-box;
    }
    .col {
        flex: 1 1 0;
        min-width: 0;
    }
    .detail {
        height: 300px;
        position: relative;
    }
    @media (max-width: 640px) {
        .container {
            flex-direction: column;
        }
        .col {
            width: 100%;
        }
    }
    .heading {
        display: inline-block;
        position: relative;
    }
    .heading h1 {
        font-family: var(--font-anton),sans-serif;
        margin: 0 0 -5px;
    }
    p {
        font-family: "sans-serif";
    }
    .custom-divider {
        display: block;
        width: 100%;
        height: 100px;
    }
</style>
