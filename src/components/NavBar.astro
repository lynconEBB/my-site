---
import FancyButton from "./FancyButton.astro";
---

<nav>
    <FancyButton text="About" trCorner="97% 15%" blCorner="5% 100%" brCorner="100% 90%"/>
    <FancyButton text="Projects" tlCorner="2% 15%" trCorner="95% 0" blCorner="0 90%" leadNudge={0.5}/>
    <FancyButton text="Blog" tlCorner="3% 0" trCorner="100% 6%" brCorner="97% 100%" blCorner="0 94%"/>
</nav>

<style>
    nav {
        display: flex;
        flex-direction: row;
        justify-content: right;
        align-items: center;
        gap: 40px;
        padding: 40px 20px;
    }
</style>
