---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";

interface Props {
    project: CollectionEntry<"projects">;
}

const { project } = Astro.props;
const { title, description, tags, image, imageAlt } = project.data;
const visibleTags = tags.slice(0, 3);
---

<div class="item">
    <div class="item-content">
        <div class="image-container">
            <Image class="item-img" src={image} alt={imageAlt} />
        </div>
        <h2 class="item-title">{title}</h2>
        <ul class="item-tags" aria-label="Project tags">
            {visibleTags.map((tag: string) => <li>{tag}</li>)}
        </ul>
        <h3 class="item-description">{description}</h3>
        <div class="card-footer"></div>
    </div>
</div>

<script>
    import shave from "shave";

    let resizeFrame = 0;

    const clampText = (selector: string, lines: number) => {
        document.querySelectorAll<HTMLElement>(selector).forEach((element) => {
            const lineHeight = Number.parseFloat(getComputedStyle(element).lineHeight);

            shave(element, Math.ceil(lineHeight * lines), { character: "..." });
        });
    };

    const clampCardText = () => {
        clampText(".item-title", 2);
        clampText(".item-description", 4);
    };

    const scheduleClamp = () => {
        cancelAnimationFrame(resizeFrame);
        resizeFrame = requestAnimationFrame(clampCardText);
    };

    scheduleClamp();
    document.fonts.ready.then(scheduleClamp);
    window.addEventListener("resize", scheduleClamp);
</script>

<style>
    .item:hover {
        cursor: pointer;
        transform: scale(1.05);
    }
    .item {
        position: relative;
        box-sizing: border-box;
        box-shadow: 5px 5px 15px 5px #000000;
        background-color: #ff2e97;
        height: 310px;
        margin-bottom: 10px;
        width: 100%;
        display: flex;
        align-items: end;
        clip-path: polygon(0 35px, 60px 35px, 70px 0, 295px 5px, 280px 35px, 100% 30px, calc(100% - 7px) calc(100% - 5px), 6px 100%);
        transition: transform 200ms ease;
    }
    .item::before {
        content:" ";
        background-color: #B5FD14;
        clip-path: polygon(10px 40px, calc(100% - 10px) 40px, calc(100% - 10px) calc(100% - 10px), 10px calc(100% - 10px));
        height: 100%;
        width: 100%;
        position: absolute;
    }
    .item-content {
        box-sizing: border-box;
        transform: skewX(-20deg);
        height: calc(100% - 10px);
    }
    .item-title {
        font-family: var(--font-anton);
        line-height: 1.2;
        margin: 0 25px 0 40px;
    }
    .item-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
        list-style: none;
        margin: 2px 0 0 50px;
        max-height: calc(0.7rem + 8px);
        overflow: hidden;
        padding: 0;
    }
    .item-tags li {
        background-color: #ff2e97;
        font-family: var(--font-oxanium);
        font-size: 0.7rem;
        font-weight: 700;
        line-height: 1;
        color: white;
        padding: 4px 8px;
        text-transform: uppercase;
        white-space: nowrap;
    }
    .item-description {
        font-size: 1rem;
        font-weight: normal;
        font-family: sans-serif;
        line-height: 1.25;
        margin: 3px 0 0 60px;
    }
    .image-container {
        margin-left: 30px;
        background-color: #B5FD14;
        width: 200px;
        aspect-ratio: 16/9;
        display: flex;
        justify-content: center;
        align-items: center;
    }
    .image-container .item-img {
        width: calc(100% - 15px);
        height: calc(100% - 15px);
        object-fit: cover;
    }

    @media (max-width: 720px ) {
        .item-content {
            transform: skewX(-14deg);
        }
        .item {
            height: 280px;
            clip-path: polygon(0 35px, 35px 35px, 40px 5px, 205px 5px, 195px 38px, 100% 30px, calc(100% - 7px) calc(100% - 5px), 6px 100%);
        }
        .image-container {
            width: 150px;
            margin-left: 10px;
        }
        .item-title {
            margin-left: 30px;
        }
        .item-tags {
            margin: 2px 15px 0 40px;
        }
        .item-description {
            margin: 2px 50px;
        }
    }
</style>
