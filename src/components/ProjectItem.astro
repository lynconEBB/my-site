---
import { Image } from "astro:assets";
import sreImage from "../assets/images/sre.png";
---

<div class="item">
    <div class="item-content">
        <div class="image-container">
            <Image class="item-img" src={sreImage} alt="SRE" />
        </div>
        <h2 class="item-title">SRE</h2>
        <h3 class="item-description">Lorem ipsum dolor sit amet, consectetur adipiscing elit. Mauris nec  </h3>
        <div class="card-footer"></div>
    </div>
</div>

<style>
    .item {
        position: relative;
        box-sizing: border-box;
        box-shadow: 5px 5px 15px 5px #000000;
        background-color: #ff2e97;
        height: 250px;
        margin-bottom: 10px;
        width: 100%;
        display: flex;
        align-items: end;
        clip-path: polygon(0 35px, 60px 35px, 70px 0, 280px 5px, 269px 35px, 100% 30px, calc(100% - 7px) calc(100% - 5px), 6px 100%);
    }
    .item::before {
        content:" ";
        background-color: #B5FD14;
        clip-path: polygon(10px 40px, calc(100% - 10px) 40px, calc(100% - 10px) calc(100% - 10px), 10px calc(100% - 10px));
        height: 100%;
        width: 100%;
        position: absolute;
    }
    .item-content {
        box-sizing: border-box;
        transform: skewX(-20deg);
        height: calc(100% - 10px);
    }
    .item-title {
        font-family: var(--font-anton);
        margin: 10px 0 0 50px;
    }
    .item-description {
        display: -webkit-box;
        overflow: hidden;
        -webkit-box-orient: vertical;
        -webkit-line-clamp: 2;
        font-size: 1rem;
        font-weight: normal;
        font-family: sans-serif;
        margin-top:0;
        margin-bottom: 0;
        margin-left: 70px;
        margin-right: 20px;
    }
    .image-container {
        margin-left: 30px;
        background-color: #B5FD14;
        width: 200px;
        height: 122px;
        display: flex;
        justify-content: center;
        align-items: center;
    }
    .image-container .item-img {
        width: calc(100% - 15px);
        height: calc(100% - 15px);
    }
    @media (max-width: 720px ) {
        .item-content {
            transform: skewX(-14deg);
        }
        .item {
            clip-path: polygon(0 35px, 31px 35px, 40px 0, 204px 5px, 193px 35px, 100% 30px, calc(100% - 7px) calc(100% - 5px), 6px 100%);
        }
        .image-container {
            margin-left: 12px;
            width: 150px;
            height: 100px;
        }
        .item-title {
            margin-left: 30px;
        }
        .item-description {
            margin-left: 50px;
        }
    }
</style>
