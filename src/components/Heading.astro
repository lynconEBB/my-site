---
import Checker from "./Checker.astro";
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"div"> {
    text: string;
    variant?: "light" | "dark";
}

const { 
    text,
    variant = "dark",
    class: className,
    ...attributes
} = Astro.props;
---

<div {...attributes} class:list={["heading", variant, className]}>
    <h1>{text}</h1>
    <Checker squareSize={5} height="10px" checkerColor={variant === "light" ? "#ff2e97" : undefined} backgroundColor={variant === "light" ? "#B5FD14" : undefined} />
</div>

<style>
    .heading {
        display: inline-block;
        position: relative;
    }
    .heading h1 {
        font-family: var(--font-anton), sans-serif;
        font-size: 3rem;
        margin: 0 0 -5px;
    }
    .heading.light h1 {
        color: white;
    }
    .heading.dark h1 {
        color: black;
    }
</style>
