<style>
	.btn:active::before {
		opacity: 0;
		transition: opacity 0.2s;
	}
	.btn::before {
		content: "";
		inset:0;
		position: absolute;
		clip-path: polygon(0 10%, 100% 0, 100% 100%, 0 90%);
		background-color: #ff2e97;
		transform: translate(5px, 5px);
	}
