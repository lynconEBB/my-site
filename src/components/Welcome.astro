	#container {
		margin-left: 20px;
	}
	.btn {
		background: none;
		position: relative;
		border: none;
		padding: 10px 20px;
	}
	.btn:hover {
		cursor: pointer;
	}
	.btn-shape {
		position: absolute;
		background-color: #B5FD14;
		clip-path: polygon(0 10%, 100% 0, 100% 100%, 0 90%);
		border: none;
		inset: 0;
		font-family: sans-serif;
	}
	.btn-text {
		position: relative;
		height: 20px;
		font-size: 38px;
		font-family: sans-serif;
		font-weight: bold;
	}
	.lead {
		color: black;
		z-index: 2;
		margin-right: -5px;
		font-size: 64px;
		-webkit-text-stroke: 5px #c8ff2e;
		text-shadow: -1px 0 #B5FD14, 0 1px #B5FD14, 1px 0 #B5FD14, 0 -1px #B5FD14;
		paint-order: stroke;
	}
</style>

<div id="container">
	<h1>Hello world</h1>
	<button class="btn">
		<span class="btn-shape"></span>
		<span class="btn-text">
			<span class="lead">P</span>rojects
		</span>
	</button>

