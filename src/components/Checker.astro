---
interface Props {
    squareSize?: number;
    panSpeed?: number;
    height?: string;
    backgroundColor?: string;
    checkerColor?: string;
}

const {
    squareSize = 10,
    panSpeed = 0,
    height = "20px",
    backgroundColor = "#ff2e97",
    checkerColor = "black"
} = Astro.props;
---

<canvas class="checker-effect"
        data-square-size={squareSize}
        data-pan-speed={panSpeed}
        data-background-color={backgroundColor}
        data-checker-color={checkerColor}>
</canvas>

<script>
    let checkers = Array.from(
        document.querySelectorAll<HTMLCanvasElement>(".checker-effect"))
        .flatMap(canvas => {
            const ctx = canvas.getContext("2d");
            if(!ctx) return [];

            return [{
                canvas,
                ctx,
                squareSize: Number(canvas.dataset.squareSize) || 10,
                panSpeed: Number(canvas.dataset.panSpeed) || 0,
                backgroundColor: canvas.dataset.backgroundColor || "#ff2e97",
                checkerColor: canvas.dataset.checkerColor || "black",
            }]
        });

    checkers.forEach(({canvas}) => {
        const resizeObserver = new ResizeObserver(() => {
            canvas.width = canvas.clientWidth;
            canvas.height = canvas.clientHeight;
        })
        resizeObserver.observe(canvas);
    });

    const drawCheckerRow = (canvas: HTMLCanvasElement, ctx: CanvasRenderingContext2D, squareSize: number, offset: number, backgroundColor: string, checkerColor: string) => {
        ctx.fillStyle = backgroundColor;
        ctx.fillRect(0, 0, canvas.width, canvas.height);

        ctx.fillStyle = checkerColor;
        let y = 0;
        let row = 0;
        while (y < ctx.canvas.height) {
            let x = (row % 2 == 0 ? 0 : squareSize) - squareSize * 2 + offset;
            while (x < ctx.canvas.width) {
                ctx.fillRect(x, y, squareSize, squareSize);
                x += squareSize * 2;
            }
            row++;
            y += squareSize;
        }
    }

    const animate = (time: number) => {
        checkers.forEach(({canvas, ctx, squareSize, panSpeed, backgroundColor, checkerColor}) => {
            const patternWidth = squareSize * 2;
            const rawOffset = ((time / 1000) * panSpeed) % patternWidth;
            const offset = (rawOffset + patternWidth) % patternWidth;
            drawCheckerRow(canvas, ctx, squareSize, offset, backgroundColor, checkerColor);
        })

        requestAnimationFrame(animate);
    }

    requestAnimationFrame(animate);
</script>


<style define:vars={{height}}>
    canvas {
        width: 100%;
        height: var(--height);
        display: block;
    }
</style>
