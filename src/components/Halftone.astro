---
interface Props {
    color?: string,
    bgColor?: string,
    radius?: number,
    gap?: number,
    class?: string,
}

const {
    class: className,
    color = "#0A193B",
    bgColor = "#ff2e97",
    gap = 2,
    radius = 5
} = Astro.props
---

<canvas
        class:list={["halftone-canvas", className]}
        data-color={color}
        data-bg-color={bgColor}
        data-gap={gap}
        data-radius={radius}>
</canvas>
<script>
    const halftones = Array.from(document.querySelectorAll<HTMLCanvasElement>(".halftone-canvas"))
        .flatMap(canvas => {
            const ctx = canvas.getContext("2d");
            if (!ctx) return [];

            return [{
                canvas,
                ctx,
                gap: Number(canvas.dataset.gap) || 2,
                radius: Number(canvas.dataset.radius) || 4,
                color: canvas.dataset.color || "#0A193B",
                bgColor: canvas.dataset.bgColor || "#ff2e97",
            }];
        });


    const drawCircle = (ctx: CanvasRenderingContext2D, x: number, y: number, radius: number ) => {
        ctx.beginPath();
        ctx.arc(x,y,radius,0, 2 * Math.PI);
        ctx.fill();
    }

    const fillWithBalls = (canvas: HTMLCanvasElement, ctx: CanvasRenderingContext2D, color: string, bgColor:string,  radius: number, gap: number = 0, targetAlpha = 0) => {
        canvas.width = canvas.clientWidth;
        canvas.height = canvas.clientHeight;

        ctx.fillStyle = bgColor;
        ctx.fillRect(0, 0, canvas.width, canvas.height);

        let x = radius;
        let y = ctx.canvas.height - radius;
        let step = radius * 2 + gap;
        let currentRadius = radius;

        const minimumVisibleRadius = 1;
        const minRadius = Math.max(radius * targetAlpha, minimumVisibleRadius);
        const rows = Math.ceil(ctx.canvas.height / step);
        const decreaseFactor = Math.pow(minRadius / radius, 1 / (rows - 1));

        ctx.fillStyle = color;
        for (let i = 0; i < rows; i++) {
            for (let i = 0; i < ctx.canvas.width / step; i++) {
                drawCircle(ctx, x, y, currentRadius);
                x += step;
            }
            if (i % 2 == 0) {
                x = 0;
            } else {
                drawCircle(ctx, x, y, currentRadius);
                x = radius;
            }
            y -= step;
            currentRadius *= decreaseFactor;
        }
    }

    halftones.forEach(({canvas, ctx, radius, gap, color, bgColor}) => {
        const resizeObserver = new ResizeObserver(() => {
            fillWithBalls(canvas, ctx, color, bgColor, radius, gap, 0);
        })
        resizeObserver.observe(canvas);
        fillWithBalls(canvas, ctx, color, bgColor, radius, gap, 0);
    });
</script>

<style>
    .halftone-canvas {
        width: 100%;
        height: 100%;
    }

</style>
