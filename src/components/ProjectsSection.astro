---
import { Image } from "astro:assets";
import sreImage from "../assets/images/sre.png";
---

<div class="container">
    <div class="filler"></div>
    <div class="first"></div>
    <div class="main-container">
        <div class="skewed">
            <div class="item">
                <div class="item-content">
                    <div class="image-container">
                        <Image class="item-img" src={sreImage} alt="SRE" />
                    </div>
                    <h2 class="item-title">SRE</h2>
                    <h3 class="item-description">Lorem ipsum dolor sit amet, consectetur adipiscing elit. Mauris nec  </h3>
                    <div class="card-footer"></div>
                </div>
            </div>
        </div>
    </div>
    <div class="last"></div>
    <div class="filler"></div>
</div>

<style>
    .container {
        margin-top:50px;
        height: 550px;
        display: flex;
        flex-direction: row;
    }
    .first {
        flex: 0 0 170px;
        background-color: #ff2e97;
        clip-path: polygon(0 0,0 0, 100% 100%, 0 100%);
        margin: 40px 0;
    }
    .last {
        flex: 0 0 170px;
        background-color: #ff2e97;
        margin: 40px 0;
        clip-path: polygon(0 0,100% 0, 100% 100%, 100% 100%);
    }
    .filler {
        margin: 40px 0;
        background-color: #ff2e97;
        flex: 1 0 0;
        box-sizing: border-box;
    }
    .main-container {
        flex: 0 1 1000px ;
        display: flex;
        max-width: 1000px;
        flex-direction: row;
        margin-inline: -20px;
        align-items: center;
        gap: 10px;
    }
    .skewed {
        width: 100%;
        height: 100%;
        padding: 20px;
        background-color: aqua;
        overflow-y: scroll;
        overflow-x: hidden;
        transform: skewX(20deg);
    }
    .item {
        position: relative;
        box-sizing: border-box;
        box-shadow: 5px 5px 15px 5px #000000;
        background-color: #ff2e97;
        height: 250px;
        width: 100%;
        display: flex;
        align-items: end;
        clip-path: polygon(0 35px, 60px 35px, 70px 0, 330px 5px, 320px 35px, 100% 30px, calc(100% - 7px) calc(100% - 5px), 6px 100%);
    }
    .item::before {
        content:" ";
        background-color: #B5FD14;
        clip-path: polygon(10px 40px,calc(100% - 10px) 40px, calc(100% - 10px) calc(100% - 10px), 10px calc(100% - 10px));
        height: 100%;
        width: 100%;
        position: absolute;
    }
    .item-content {
        box-sizing: border-box;
        transform: skewX(-20deg);
        height: calc(100% - 10px);
    }
    .item-title {
        font-family: var(--font-anton);
        margin: 10px 0 0 50px;
    }
    .item-description {
        font-size: 1rem;
        font-weight: normal;
        font-family: sans-serif;
        margin: 0 50px;
    }
    .image-container {
        margin-left: 30px;
        background-color: #B5FD14;
        width: 250px;
        height: 142px;
        display: flex;
        justify-content: center;
        align-items: center;
    }
    .image-container .item-img {
        width: calc(100% - 15px);
        height: calc(100% - 15px);
    }
</style>
