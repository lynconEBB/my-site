---

---

<div class="container">
    <div class="filler"></div>
    <div class="first"></div>
    <div class="main-container">
        <div class="skewed">
        </div>
    </div>
    <div class="last"></div>
    <div class="filler"></div>
</div>

<style>
    .container {
        margin-top:50px;
        height: 550px;
        display: flex;
        flex-direction: row;
    }
    .first {
        flex: 0 0 200px;
        background-color: #ff2e97;
        clip-path: polygon(0 0,0 0, 100% 100%, 0 100%);
    }
    .last {
        flex: 0 0 200px;
        background-color: #ff2e97;
        clip-path: polygon(0 0,100% 0, 100% 100%, 100% 100%);
    }
    .filler {
        background-color: #ff2e97;
        flex: 1 0 0;
        box-sizing: border-box;
    }
    .main-container {
        flex: 0 1 1000px ;
        display: flex;
        max-width: 1000px;
        flex-direction: row;
        margin-inline: -80px;
        align-items: center;
        gap: 10px;
    }
    .skewed {
        width: 100%;
        height: 100%;
        background-color: aquamarine;
        overflow-y: scroll;
        overflow-x: hidden;
        transform: skewX(20deg);
    }
    .item {
        box-sizing: border-box;
        background-color: aqua;
        margin-bottom: 5px;
        height: 100px;
        width: 150px;
    }
    .item-content {
        box-sizing: border-box;
        transform: skewX(-30deg);
    }
</style>